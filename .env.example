# Katha — copy to .env and fill in. Never commit .env.

# Core
KATHA_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./katha.db   # prod: postgresql+asyncpg://...

# Anthropic (interviewer brain + pipeline)
ANTHROPIC_API_KEY=

# Sarvam AI (Indic STT + TTS) — https://docs.sarvam.ai
SARVAM_API_KEY=

# LiveKit (realtime voice + SIP bridge)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SIP trunk (Twilio Elastic SIP for v0; Exotel later for India-domestic)
SIP_TRUNK_ID=

# Object storage for call audio (Cloudflare R2, S3-compatible)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=katha-audio

# Local audio (dev): skip R2 by pointing at a folder of REAL call recordings,
# named by each session's audio_key. The API serves them over signed links, so
# the in-app cassette plays and its reels turn. No recordings = no playback
# (the player honestly says "not yet synced"); this never invents audio.
LOCAL_AUDIO_DIR=
PUBLIC_BASE_URL=http://localhost:8000
AUDIO_SIGN_SECRET=dev-local-audio

# LLM backend: "api" (Anthropic SDK, needs credits; required for live calls)
# or "claude-cli" (headless Claude Code on your subscription - free, dev only)
LLM_BACKEND=
CLI_MODEL=sonnet
